# ============================================================
# FQ - variables de entorno (ejemplo). Copia a .env y completa.
# NUNCA subas tu .env real al repo.
# ============================================================

# ---- OBLIGATORIAS ----
TELEGRAM_TOKEN=                 # token del bot VIP (BotFather)
TELEGRAM_TOKEN_PUBLIC=          # token del bot publico (BotFather)
TELEGRAM_CHAT_ID=               # tu chat_id de admin (notificaciones + backup)
ANTHROPIC_API_KEY=              # API key de Anthropic (lecturas y analisis)

# ---- PERSISTENCIA (monta un Railway Volume en /data) ----
FQ_LEDGER_PATH=/data/fq_ledger.db        # ledger de senales del VIP
FQ_VIP_DB_PATH=/data/fq_vip.db           # usuarios y suscripciones
FQ_PUBLIC_DB_PATH=/data/fq_public.db     # subscribers del bot publico
FQ_VIP_LEDGER_PATH=/data/fq_ledger.db    # ledger VIP en RO para el bot publico
FQ_HEARTBEAT_DIR=/data/heartbeat         # latidos del watchdog

# ---- BOT PUBLICO ----
FQ_VIP_BOT_USERNAME=            # username del bot VIP (sin @), para deep links

# ---- OBSERVABILIDAD ----
FQ_JSON_LOGS=0                  # 1 = logs en JSON por linea (produccion)
FQ_LOG_LEVEL=INFO               # DEBUG / INFO / WARNING / ERROR

# ---- BACKUP / WATCHDOG ----
FQ_BACKUP_HOURS=6               # cada cuantas horas respalda el ledger
FQ_VIP_STALE_MIN=15             # alerta si el VIP no late en N min
FQ_PUBLIC_STALE_MIN=20          # alerta si el publico no late en N min
S3_BUCKET=                      # opcional: si se setea, backup tambien a S3 (requiere boto3)

# ---- MOTOR (flags; los defaults son sensatos, dejar vacio = default) ----
FQ_EMERGENT_TIME_ENABLED=0      # 1 = activa Phase E (validar en shadow antes)
FQ_WEEKEND_VETO=1               # 0 = opera fin de semana (no recomendado)
FQ_WEEKEND_ADMIN_ONLY=1         # 1 = genera senales en finde pero solo las entrega al admin (VIP/trial/free vetados); 0 = veto total para todos
FQ_DEAD_2PM_MANIP=1             # 1 = franja muerta 2PM CDMX (manipulacion); 0 = off
FQ_DEAD_2PM_START=14.0          # inicio franja 2PM (hora CDMX decimal)
FQ_DEAD_2PM_END=15.0            # fin franja 2PM (hora CDMX decimal)
FQ_ASIA_FAKEOUT_GUARD=1         # 1 = bloquea LONG tactico de bajo vol en asia_open (bull fakeout); 0 = off
FQ_ASIA_FAKEOUT_VOL_MIN=0.85    # vol_score minimo para promover un LONG en asia_open

# ---- VETO DE SESION (F2.6, RETRIEVAL_PLAN §6.8; capa de decision, default OFF) ----
# Veta la senal por el SEGMENTO temporal de la VELA (killzone / bloque-UTC 4h /
# dia). OR de los tres. Mismo predicado en research, regrade offline y vivo.
# OJO: en vivo veta la senal VIP a CLIENTES en esa franja (no solo paper).
FQ_SEGMENT_VETO_KILLZONES=      # CSV de killzones vetadas (p.ej. london_open_kz)
FQ_SEGMENT_VETO_UTC_BLOCKS=     # CSV de bloques 4h UTC (p.ej. 00-04,04-08)
FQ_SEGMENT_VETO_WEEKDAYS=       # CSV de dias (lun,mar,mie,jue,vie,sab,dom)

# ---- GATE ORO PAPER: shadow maker (medir fill-rate de limites; no toca posiciones) ----
FQ_GOLD_MAKER_SIM=0             # 1 = registra MAKER_FILL/MISS por cada ORO (RETRIEVAL_PLAN §6.10)
FQ_GOLD_MAKER_EPS_BPS=1.0       # penetracion minima del nivel para considerar fill (touch no llena)
FQ_GOLD_MAKER_TTL_BARS=6        # velas de vida de la limite simulada antes de MISS

# ---- MOTOR PAPER: subset correcto §6.10.1 (motor base + veto + shadow maker; default OFF) ----
# Abre en PAPEL las senales del MOTOR BASE filtradas por su propio veto (default
# london) y mide el fill-rate maker REAL — el juez del techo +0.10R. 0% real,
# paralelo al ORO. Analiza con: python tools/motor_paper_stats.py
FQ_MOTOR_PAPER=0                # 1 = enciende el track motor paper (admin-only)
FQ_MOTOR_PAPER_TF=5m            # TF del fire que se mide (=research/cubo y BTC; el loop evalua 5m+15m)
FQ_MOTOR_PAPER_VETO_KILLZONES=london_open_kz   # veto PROPIO (independiente del veto VIP); ""=motor base puro
FQ_MOTOR_PAPER_VETO_UTC_BLOCKS= # veto secundario por bloque-UTC (p.ej. 00-04,04-08)
FQ_MOTOR_PAPER_VETO_WEEKDAYS=   # veto secundario por dia (p.ej. lun)
FQ_MOTOR_PAPER_MAKER_SIM=1      # shadow maker ON por default (es el punto del track)
FQ_MOTOR_PAPER_TP=tp1           # nivel del report usado como TP (tp1 = ganador del cubo)
FQ_MOTOR_PAPER_LEDGER_PATH=     # vacio = /data/motor_paper_<sym>.jsonl (en el Volume)
FQ_MOTOR_PAPER_EQUITY=10000     # equity de la cuenta paper
# ---- BTC pipeline PARALELO (paper-only, 0% real, default OFF) ----
# Valida FORWARD el techo del research: la cosecha 5m midio en BTC el edge maker
# MAS ALTO (+0.142R con exit ancho tp4, vs SOL +0.018R). Corre el MISMO motor
# sobre barras BTC y alimenta un ledger BTC SEPARADO. JAMAS broadcastea ni toca
# SOL/VIP. Comparte tp/veto/maker/equity con el motor de arriba (poner
# FQ_MOTOR_PAPER_TP=tp4 + FQ_MOTOR_PAPER_VETO_KILLZONES="" = config del techo).
# Se lee en /paper (SOL + BTC lado a lado) o:
#   python tools/motor_paper_stats.py /data/motor_paper_BTC_USDT.jsonl
FQ_MOTOR_PAPER_BTC=0            # 1 = enciende el pipeline BTC paralelo
FQ_MOTOR_PAPER_BTC_TF=5m       # TF del research/cosecha (dejar en 5m)
FQ_MOTOR_PAPER_BTC_LEDGER_PATH= # vacio = /data/motor_paper_BTC_USDT.jsonl (SEPARADO del SOL)
# ---- CARRY PAPER: 2do motor MARKET-NEUTRAL (forward, 0% real, default OFF) ----
# Acumula el funding REALIZADO del basket CLEAN (BTC/ETH/XRP/LTC/DOGE/ADA — validado
# multi-regimen, positivo los 6 anios incl. bear 2022; ver research/carry_regime.md)
# en un parquet durable en /data y mide el carry HACIA ADELANTE. Hijo NO-critico del
# launcher (un bug jamas tira el VIP). Lee el accrual: python tools/carry_paper.py --report
FQ_CARRY_PAPER=0               # 1 = enciende el colector forward del carry
FQ_CARRY_INTERVAL=3600         # seg entre polls (funding liquida c/8h; 1h solapa de sobra)
FQ_CARRY_BACKFILL=200          # settlements por poll (~66d a 8h); da historia inmediata
FQ_CARRY_DIR=                  # vacio = /data (el Volume); parquet + snapshot.json ahi
FQ_ZONE_REACH_BIAS=0.25         # peso de cercania en seleccion de zona (0=puro edge, 0.5=legacy)
FQ_ZONE_FRESH_TIEBREAK=1        # 1 = empate -> gana el FVG mas fresco (ult. displacement)
FQ_USE_THOMPSON=1               # 0 = kappa lineal en vez de Thompson
FQ_REQUIRE_OTE=0                # 1 = exige retroceso optimo estricto
FQ_TIMEFRAMES=                  # vacio = default (4H/1H/15m/...)
FQ_PHASE_E_N_PATHS=300
FQ_SYNC_WEIGHTS=0.30,0.25,0.20,0.15,0.10

# ---- EJECUCION / EXCHANGE (capa de trading; arranca en paper) ----
FQ_EXEC_MODE=paper              # paper = precios reales sin orden | live = sub-cuenta real
FQ_EXEC_EXCHANGE=okx            # venue de ejecucion (mismo que la data: minimiza drift)
FQ_EXEC_MARKET_TYPE=swap        # swap (perpetuo USDT lineal) | spot
OKX_API_KEY=                    # API key de la SUB-CUENTA de ejecucion (no la maestra)
OKX_SECRET=                     # secret de la sub-cuenta
OKX_PASSWORD=                   # passphrase de la API (OKX exige 3 factores)
OKX_SUBACCOUNT=                 # nombre de la sub-cuenta (opcional segun setup)

# ---- PAGOS (opcional) ----
FQ_STRIPE_LINK=                 # link de checkout de Stripe (bot publico)
STRIPE_SECRET_KEY=              # clave secreta de Stripe (webhook)
STRIPE_WEBHOOK_SECRET=          # secreto HMAC del webhook de Stripe
FQ_USDT_ADDRESS=                # direccion USDT mostrada en /crypto
FQ_USDT_NETWORK=TRC20           # TRC20 o ERC20
CRYPTO_USDT_TRC20_ADDRESS=      # wallet Tron para verificacion on-chain
CRYPTO_USDT_ERC20_ADDRESS=      # wallet Ethereum para verificacion on-chain
ETHERSCAN_API_KEY=              # para verificar pagos ERC20
LANDING_URL=                    # url de redireccion tras pago Stripe
