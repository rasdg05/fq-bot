# Configuración de Marea. Ninguna de estas variables es obligatoria: lo que
# falta degrada al camino simulado y la app lo declara (R-022).

# --- fuente de datos ---
# mock (default) | aggregated
VITE_DATA_SOURCE=mock
# series de Kalshi a curar, separadas por coma. Vacío = listado general, que
# viene dominado por combinadas deportivas sin liquidez.
VITE_KALSHI_SERIES=KXBTCD,KXETHD,KXCPIYOY,KXFEDDECISION

# --- telemetría ---
# sin endpoint, los eventos se quedan en memoria y no sale nada del dispositivo
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_KEY=
VITE_ANALYTICS_SAMPLE_RATE=1
VITE_ERROR_ENDPOINT=
VITE_ERROR_KEY=
VITE_VITALS=true

# --- wallet y depósito (aún sin implementación real: ver vault/COMPLIANCE.md) ---
VITE_WALLET_PROVIDER=
VITE_WALLET_APP_ID=
VITE_ONRAMP_PROVIDER=

# --- versión que acompaña cada evento y error ---
VITE_RELEASE=dev
