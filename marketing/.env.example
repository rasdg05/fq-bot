# Credenciales de la Marketing API de Meta (NO commitear: .env esta en .gitignore)
# Como obtener cada valor: ver docs/META_API_SETUP.md

# Token de System User (Business Manager) con permiso ads_management.
META_ACCESS_TOKEN=

# ID de la cuenta publicitaria, SIN el prefijo act_ (solo los numeros).
META_AD_ACCOUNT_ID=

# ID de la Pagina de Facebook vinculada (identidad del anuncio).
META_PAGE_ID=

# ID de la cuenta profesional de Instagram (instagram_actor_id).
META_IG_ACTOR_ID=

# Opcional: version del Graph API (default v21.0).
META_GRAPH_VERSION=v21.0
